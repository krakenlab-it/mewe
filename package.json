{
  "name": "mewe",
  "version": "1.0.0",
  "private": true,
  "description": "ME WE frontend powered by Vite",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174 --strictPort --open /",
    "ref": "node scripts/replit-reference-proxy.mjs",
    "dev:both": "node scripts/replit-reference-proxy.mjs & vite --host 0.0.0.0 --port 5174 --strictPort --open /",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4174",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.mjs",
    "supabase:start": "supabase start -x studio,imgproxy,inbucket,realtime,storage,edge-runtime,functions,vector,analytics",
    "supabase:stop": "supabase stop --no-backup",
    "supabase:env": "./scripts/export-supabase-env.sh",
    "test:e2e:local": "npm run supabase:start && eval \"$(./scripts/export-supabase-env.sh)\" && npm run test:e2e"
  },
  "keywords": [
    "vite",
    "frontend",
    "mewe"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
