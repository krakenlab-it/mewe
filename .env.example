# Supabase (required in production)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Backend mode: local | auto | supabase
# Production (Vercel): use supabase
VITE_MEWE_BACKEND_MODE=supabase

# Local facilitadora password. Required for /admin and for taller admin when
# VITE_MEWE_BACKEND_MODE=local. There is no built-in password.
# Omit in production. If set, this value is visible in the frontend bundle.
# VITE_MEWE_LOCAL_ADMIN_PASS=your-dev-password

# Interactive dashboard feature flags (optional)
# VITE_MEWE_ASSISTANT_ENABLED=true
# VITE_MEWE_WHATSAPP_ENABLED=true

# Optional WhatsApp delivery webhook (no secrets in git).
# If unset, Me We opens wa.me with the typed message and stores the log locally.
# VITE_MEWE_WHATSAPP_WEBHOOK_URL=

# Replit parity app (default at /). Assessment remains at /taller.

# Live Replit reference proxy (npm run ref) — no secrets
# REPLIT_REF_URL=https://juntas-fuertes--yepezmancheno.replit.app
# REPLIT_REF_PORT=5173
